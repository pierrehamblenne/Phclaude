# --- Boîte OVH Exchange (obligatoire) ---
OVH_EMAIL=prenom.nom@exemple.fr
OVH_PASSWORD=ton_mot_de_passe_ou_app_password
# OVH nous oblige à préciser l'endpoint EWS explicitement.
# Essaye dans l'ordre : ex.mail.ovh.net -> ex3.mail.ovh.net -> mail.ovh.net
OVH_EWS_SERVER=ex.mail.ovh.net
OVH_TIMEZONE=Europe/Paris
# En dernier recours si TLS chain échoue (déconseillé) : 1
# OVH_SKIP_TLS_VERIFY=0

# --- WhatsApp via Twilio (recommandé pour les récaps) ---
# Console Twilio -> Messaging -> Try it out -> WhatsApp sandbox
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
NOTIFY_WHATSAPP_TO=whatsapp:+33612345678

# --- Telegram (alternative gratuite à WhatsApp) ---
# Parle à @BotFather pour créer un bot ; récupère ton chat_id avec @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Email fallback (utilise la boîte OVH elle-même pour s'auto-envoyer le récap) ---
NOTIFY_EMAIL_TO=prenom.nom@exemple.fr
